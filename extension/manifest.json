{
  "manifest_version": 3,
  "name": "סוכן האינטרנט - מחבר",
  "version": "1.0.0",
  "description": "מחבר את הדפדפן הזה לשרת סוכן האינטרנט שלך ומבצע את פעולות הדפדפן שלו על אתר פנימי אחד שהוגדר מראש.",
  "permissions": [
    "storage",
    "scripting",
    "tabs",
    "debugger",
    "downloads",
    "notifications",
    "alarms"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "סוכן האינטרנט",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "options_page": "options.html",
  "minimum_chrome_version": "116"
}
